{
  "entities": {
    "Default": {
      "view": {
        "renderer": "html"
      },
      "combatant": {
        "bars": [
          {
            "attribute": "data.hp",
            "title": "Common.HitPoints",
            "label": "Common.HP",
            "temporary": false
          },
          {
            "attribute": "data.stress",
            "title": "Common.Stress",
            "label": "Common.Stress",
            "temporary": false
          }
        ]
      }
    },
    "Adversary": {
      "role": "enemy",
      "collection": {
        "detail": "{{data.tier|map: 'Tier'}} {{data.type|map: 'AdversaryType'}} {{data.typeDetail|brackets}}"
      }
    },
    "Environment": {
      "role": "enemy",
      "collection": {
        "detail": "{{data.tier|map: 'Tier'}} {{data.type|map: 'EnvironmentType'}} {{data.typeDetail|brackets}}"
      }
    },
    "Weapon": {
      "collection": {
        "detail": "{% if data.category %}{{data.category|map: 'WeaponCategory'}}{% else %}{{'Entity.Weapon'|l}}{% endif %} - {{data.tier|map: 'Tier'}}"
      }
    },
    "DomainCard": {
      "collection": {
        "detail": "{{'Common.Level'|l}} {{data.level}} {{data.type|map: 'DomainCardType'}}"
      }
    },
    "Character": {
      "role": "friendly",
      // opens as the GM card (views/character.html), whose "Open sheet" button opens sheets/character
      "view": {
        "renderer": "html",
        "sheet": "character"
      },
      "collection": {
        "detail": "{{data.class.name|default: 'Custom'}}"
      }
    }
  },
  "resources": [
    {
      "id": "fear",
      "label": "Fear",
      "min": 0,
      "max": 12,
      "visibility": "players"
    },
    {
      "id": "countdown",
      "type": "countdown",
      "label": "Coundown",
      "icon": "gi-sands-of-time",
      "min": 0,
      "visibility": "players"
    }
  ],
  "viewThemes": [
    { "id": "night", "label": "Night (dark interface)" }
  ],
  "combat": {
    "initiative": {
      "mode": "fixed"
    }
  }
}